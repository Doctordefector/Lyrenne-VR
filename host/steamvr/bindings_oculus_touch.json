{
  "controller_type": "oculus_touch",
  "name": "Lyrenne wrist player defaults",
  "bindings": {
    "/actions/lyrenne": {
      "poses": [
        {
          "output": "/actions/lyrenne/in/left_grip",
          "path": "/user/hand/left/pose/openxr_grip"
        },
        {
          "output": "/actions/lyrenne/in/right_grip",
          "path": "/user/hand/right/pose/openxr_grip"
        },
        {
          "output": "/actions/lyrenne/in/left_aim",
          "path": "/user/hand/left/pose/openxr_aim"
        },
        {
          "output": "/actions/lyrenne/in/right_aim",
          "path": "/user/hand/right/pose/openxr_aim"
        }
      ],
      "haptics": [
        {
          "output": "/actions/lyrenne/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/lyrenne/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "sources": []
    },
    "/actions/lyrenne_click": {
      "sources": [
        {
          "mode": "trigger",
          "path": "/user/hand/left/input/trigger",
          "inputs": {
            "pull": {
              "output": "/actions/lyrenne_click/in/left_trigger"
            }
          }
        },
        {
          "mode": "trigger",
          "path": "/user/hand/right/input/trigger",
          "inputs": {
            "pull": {
              "output": "/actions/lyrenne_click/in/right_trigger"
            }
          }
        }
      ]
    }
  }
}